{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "description": "Tally — phone camera to browser, on-air.",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server.js",
    "start": "electron .",
    "icons": "node scripts/build-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "cloudflared": "^0.7.1",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "io.github.nokusukun.tally",
    "productName": "Tally",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json",
      "!**/*.map",
      "!**/test/**",
      "!**/*.md"
    ],
    "asarUnpack": [
      "node_modules/cloudflared/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nokusukun",
        "repo": "tally"
      }
    ]
  }
}
